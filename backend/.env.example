# Runtime environment: local, ci, or production
ENV=local

# SQLAlchemy connection URL for the local PostgreSQL container
DATABASE_URL=postgresql+psycopg://tzamot:tzamot@127.0.0.1:5432/tzamot

# Optional. Pytest defaults to this sibling database and never uses DATABASE_URL.
# TEST_DATABASE_URL=postgresql+psycopg://tzamot:tzamot@127.0.0.1:5432/tzamot_test

# Application log verbosity
LOG_LEVEL=DEBUG

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Business timezone used at application boundaries
TZ=Asia/Jerusalem

# Local-only placeholder token; replace it outside local development
ADMIN_TOKEN=dev-token
